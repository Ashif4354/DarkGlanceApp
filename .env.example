# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Site URL for metadata & OpenGraph resolution (optional)
NEXT_PUBLIC_SITE_URL=https://darkglance.in

# Optional GitHub Personal Access Token to increase GitHub REST API rate limits (from 60/hr to 5,000/hr) for live repository pulse data
GITHUB_TOKEN=
